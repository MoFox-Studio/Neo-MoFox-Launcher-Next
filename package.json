{
  "name": "neo-mofox-launcher",
  "version": "0.1.0",
  "description": "Neo-MoFox Launcher — Electron + Vue 3 + TypeScript rewrite",
  "author": "Neo-MoFox",
  "private": true,
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:electron": "wait-on tcp:5199 dist/main/index.js dist/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .",
    "dev:demo": "cross-env VITE_MOFOX_DEMO=true vite",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main && npm run typecheck:preload",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "rebuild:native": "electron-rebuild -f",
    "pack:dir": "npm run build && npm run rebuild:native && electron-builder --dir --config electron-builder.yml",
    "package": "npm run pack:dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "extract-zip": "^2.0.1",
    "material-symbols": "^0.27.0",
    "node-pty": "^1.1.0",
    "pinia": "^2.2.6",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.2"
  }
}
